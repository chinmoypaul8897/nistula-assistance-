# ─── Nistula Assistance · environment registry (plan.md §3.7) ───
# Names only — NEVER values. Real values live in local .env (gitignored)
# and Railway variables only. Add new variables to plan.md §3.7 FIRST.

# Core (required from CH-00)
NODE_ENV=
PORT=
TZ=
LOG_LEVEL=

# Database (required from CH-01)
DATABASE_URL=

# Anthropic (required from CH-04)
ANTHROPIC_API_KEY=
MODEL_ID=
MODEL_ID_LIGHT=

# WhatsApp / Meta Cloud API (required from CH-02)
# WA_ACCESS_TOKEN MUST be a System User permanent token — dashboard test
# tokens expire in 24h and will break dev daily (plan §3.7).
GRAPH_BASE_URL=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# Website quote API (required from CH-05) — dev: vercel preview · prod: https://nistula.life
WEBSITE_BASE_URL=

# eZee PMS (required from CH-10)
# EZEE_POLLER_ENABLED default 0 — the poller ACKs eZee's shared un-ACKed
# queue, so exactly ONE environment may run it: Railway sets 1, local never
# does (a dev poller would consume real bookings prod then never sees).
EZEE_BASE_URL=
EZEE_HOTEL_CODE=
EZEE_AUTH_CODE=
EZEE_USER_AGENT=
EZEE_POLLER_ENABLED=

# Lifecycle engine (CH-12) — the four fail-closed gates.
# LIFECYCLE_SEND_ENABLED default 0: rows are SCHEDULED but nothing is SENT.
#   Merging CH-12 must not, by itself, start messaging real people.
# LIFECYCLE_EPOCH: IST wall clock (YYYY-MM-DDTHH:mm) — the cutover INSTANT.
#   Bookings first mirrored before it get no lifecycle, ever (this is what makes
#   the 123 historical rows in the mirror inert). UNSET ⇒ nothing is scheduled.
# LIFECYCLE_SOURCES default "Internet Booking Engine,Walk-in" — the fail-closed
#   answer to Q13: no OTA guest is messaged until the business says we may.
# WA_TEMPLATE_MODE default simulate — real Meta templates need the real WABA.
LIFECYCLE_SEND_ENABLED=
LIFECYCLE_EPOCH=
LIFECYCLE_SOURCES=
WA_TEMPLATE_MODE=

# Staff & ops
# OPS_NUMBERS: comma-separated E.164
# STAFF_ROSTER_JSON: [{"name":"…","phone":"+91…","role":"housekeeping|maintenance|frontdesk","villas":["B1","B3"]}]
OPS_NUMBERS=
STAFF_ROSTER_JSON=

# Behaviour (defaults: DRAFT_MODE=true · NIGHT_START=20:00 · NIGHT_END=10:00)
DRAFT_MODE=
AUTO_SEND_TYPES=
NIGHT_START=
NIGHT_END=

# Admin & ops (defaults: ADMIN_ROUTES_ENABLED=0 · QUIET_STALE_MINUTES=180 ·
# COST_ALERT_INR_PER_DAY=1000)
ADMIN_BEARER_TOKEN=
ADMIN_ROUTES_ENABLED=
HEALTHCHECKS_URL=
# Business-hours minutes with NOTHING arriving through the webhook (no guest
# inbound, no coexistence echo) before the quiet-channel alert. Positive int.
QUIET_STALE_MINUTES=
COST_ALERT_INR_PER_DAY=

# CH-18a-2 coexistence keep-alive (defaults: COEXISTENCE_ACTIVE=0 ·
# COEXISTENCE_KEEPALIVE_MAX_DAYS=13). Flip ACTIVE=1 at real-number cutover.
COEXISTENCE_ACTIVE=
COEXISTENCE_KEEPALIVE_MAX_DAYS=

# CH-18a-2 encrypted off-site backups (default BACKUP_ENABLED=0 — ONLY Railway
# sets 1; the image must carry pg_dump v16 + age). BACKUP_AGE_RECIPIENT is the
# age PUBLIC key; the S3 creds are secrets (R2/B2, path-style, region 'auto').
BACKUP_ENABLED=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=

# Dev/test only — boot-refused in production. IST wall clock, e.g. 2026-12-20T23:42
FAKE_NOW_IST=
